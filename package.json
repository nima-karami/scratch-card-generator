{
  "name": "scratch-card-generator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "extract-alpha": "tsx apps/server/src/scripts/extract-alpha.ts",
    "generate-spritesheet": "tsx apps/server/src/scripts/generate-spritesheet.ts",
    "generate-particle-spritesheet": "tsx apps/server/src/scripts/generate-particle-spritesheet.ts",
    "generate-kling-video": "tsx apps/server/src/scripts/generate-kling-video.ts",
    "generate-sound-effect": "tsx apps/server/src/scripts/generate-sound-effect.ts",
    "generate-title-image": "tsx apps/server/src/scripts/generate-title-image.ts",
    "generate-video-background": "tsx apps/server/src/scripts/generate-video-background.ts",
    "generate-container-image": "tsx apps/server/src/scripts/generate-container-image.ts",
    "generate-glyph-sheet": "tsx apps/server/src/scripts/generate-glyph-sheet.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.0.0"
}
