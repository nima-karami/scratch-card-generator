{
  "name": "scratch-card-generator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "extract-alpha": "tsx apps/server/src/scripts/extract-alpha.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.0.0"
}
