# AI APIs
GEMINI_API_KEY=
IMAGE_GEN_PROVIDER=
REMOVEBG_API_KEY=

# Eleven Labs sound effects (elevenlabs.io). Required for sound-effect generation and POST /api/sound-effect.
ELEVENLABS_API_KEY=
# Optional: directory to save generated sound effects with sequential ids (0001-slug.mp3, 0002-slug.mp3, …) and sound-effect-log.txt
SOUND_EFFECT_DEBUG_OUTPUT_DIR=./debug/sound-effect

# Title image (scratch card title). Uses GEMINI_API_KEY. Optional debug output:
# TITLE_IMAGE_DEBUG_OUTPUT_DIR=./debug/title-image

# Kling 3.0 video generation (kling3api.com). Required for POST /api/kling/video and generate-kling-video script.
KLING_API_KEY=
# Optional overrides (see apps/server/src/config.ts):
# KLING_BASE_URL=https://kling3api.com
# KLING_POLL_TIMEOUT_MS=600000
# KLING_POLL_INTERVAL_MS=15000

# Redis (port must match REDIS_URL; used by docker-compose for host mapping)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
MAX_CONCURRENT_JOBS=10
MAX_GENERATIONS_PER_USER=2
MAX_PROMPT_LENGTH=200

# Frontend
VITE_API_URL=http://localhost:3001

# Spritesheet QA
SPRITESHEET_QA_LLM_ENABLED=true
SPRITESHEET_QA_ALGORITHMIC_ENABLED=true
SPRITESHEET_QA_MAX_RETRIES=3
# Optional: directory to save each QA attempt image (attempt-1.png, attempt-2.png, ...) and qa-log.txt
SPRITESHEET_QA_DEBUG_OUTPUT_DIR=./debug/spritesheet

# Optional: directory to save generated title images (0001-slug.png, …) and title-image-log.txt
TITLE_IMAGE_DEBUG_OUTPUT_DIR=./debug/title-image

# Optional: directory to save generated looped video backgrounds (0001-slug.mp4, 0001-slug-frame.png, video-background-log.txt)
VIDEO_BACKGROUND_DEBUG_OUTPUT_DIR=./debug/video-background

# Container background images: solid needs no key; gradient/pattern use GEMINI_API_KEY.
# Optional: directory to save generated container images (0001-slug.png, …) and container-image-log.txt
CONTAINER_IMAGE_DEBUG_OUTPUT_DIR=./debug/container-image


