# =============================================================================
# Server & infra
# =============================================================================
PORT=3001
MAX_GENERATIONS_PER_USER=2
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
MAX_CONCURRENT_JOBS=10

# =============================================================================
# API keys (consumed via apps/server/src/config.ts)
# =============================================================================
# Gemini — image gen, Veo, container gradient/pattern, spritesheet QA
GEMINI_API_KEY=

# ElevenLabs — sound effects (elevenlabs.io)
ELEVENLABS_API_KEY=

# Kling 3.0 — video generation (kling3api.com)
KLING_API_KEY=
# KLING_BASE_URL=https://kling3api.com
# KLING_POLL_TIMEOUT_MS=600000
# KLING_POLL_INTERVAL_MS=15000

# =============================================================================
# Feature options
# =============================================================================
# Spritesheet QA
SPRITESHEET_QA_LLM_ENABLED=true
SPRITESHEET_QA_ALGORITHMIC_ENABLED=true
SPRITESHEET_QA_MAX_RETRIES=3

# Title image QA (LLM verification + regeneration)
TITLE_IMAGE_QA_ENABLED=true
TITLE_IMAGE_QA_MAX_RETRIES=2

# =============================================================================
# Debug output (optional — when set, generated assets are written to these dirs)
# =============================================================================
# SOUND_EFFECT_DEBUG_OUTPUT_DIR=./debug/sound-effect
# TITLE_IMAGE_DEBUG_OUTPUT_DIR=./debug/title-image
# WIN_MESSAGE_IMAGE_DEBUG_OUTPUT_DIR=./debug/win-message-image
# NEXT_BUTTON_IMAGE_DEBUG_OUTPUT_DIR=./debug/next-button-image
# BACKGROUND_DEBUG_OUTPUT_DIR=./debug/background
# CONTAINER_IMAGE_DEBUG_OUTPUT_DIR=./debug/container-image
# SPRITESHEET_QA_DEBUG_OUTPUT_DIR=./debug/spritesheet
# GLYPH_SHEET_DEBUG_OUTPUT_DIR=./debug/glyph-sheet
# THEME_DEBUG_OUTPUT_DIR=./debug/theme
# THEME_MANIFEST_DEBUG_OUTPUT_DIR=./debug/theme-manifest
# THEME_ASSETS_DEBUG_OUTPUT_DIR=./debug/theme-assets
# MOODBOARD_DEBUG_OUTPUT_DIR=./debug/moodboard

# =============================================================================
# Frontend
# =============================================================================
VITE_API_URL=http://localhost:3001
