# AI APIs
GEMINI_API_KEY=
IMAGE_GEN_PROVIDER=
REMOVEBG_API_KEY=

# Redis (port must match REDIS_URL; used by docker-compose for host mapping)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
MAX_CONCURRENT_JOBS=10
MAX_GENERATIONS_PER_USER=2
MAX_PROMPT_LENGTH=200

# Frontend
VITE_API_URL=http://localhost:3001

# Spritesheet QA
SPRITESHEET_QA_LLM_ENABLED=true
SPRITESHEET_QA_ALGORITHMIC_ENABLED=true
SPRITESHEET_QA_MAX_RETRIES=3
# Optional: directory to save each QA attempt image (attempt-1.png, attempt-2.png, ...) and qa-log.txt
# SPRITESHEET_QA_DEBUG_OUTPUT_DIR=./qa-debug
